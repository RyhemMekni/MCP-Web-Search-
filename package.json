{
  "name": "searxlens-mcp",
  "version": "0.1.0",
  "description": "MCP server for SearXNG web search, with multi-query fan-out/dedupe, relevance filtering, instance failover, and URL reading.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "searxlens-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "tsc --watch"
  },
  "keywords": ["mcp", "searxng", "search", "web-search", "llm", "claude"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "node-html-parser": "^6.1.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
